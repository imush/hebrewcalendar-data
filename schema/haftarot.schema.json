{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Haftarot per parsha × custom",
  "type": "object",
  "patternProperties": {
    "^[A-Z][A-Z_]+$": {
      "type": "object",
      "patternProperties": {
        "^(ASHKENAZ|ITALKI|FRANKFURT|LITA|CHAYEY_ODOM|HAGRA|SEFARD|CHABAD|MAGREB|ALGERIA|MOROCCO|FES|MARRAKESH|TOSHBIM|DJERBA|BAVLIM|TEIMAN|BALADI|SHAMI)$": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "book",
              "fromCh",
              "fromV",
              "toCh",
              "toV"
            ],
            "properties": {
              "book": {
                "type": "string"
              },
              "fromCh": {
                "type": "integer",
                "minimum": 1
              },
              "fromV": {
                "type": "integer",
                "minimum": 1
              },
              "toCh": {
                "type": "integer",
                "minimum": 1
              },
              "toV": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
